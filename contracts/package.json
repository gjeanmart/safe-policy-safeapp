{
  "name": "safe-policy-sandbox-contracts",
  "private": true,
  "version": "0.1.0",
  "license": "LGPL-3.0-only",
  "description": "Experimental policies for the Safe Policy Engine: SpendingLimitPolicy and AllOfPolicy.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc --noEmit",
    "export:v2-abi": "hardhat compile --quiet && ts-node scripts/export-v2-abi.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3"
  }
}
